PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Security
JWT_SECRET=safe-placeholder-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# PostgreSQL Connection Configuration
# Option A: Hosted Database URL (Supabase, Neon, Render, RDS, etc.)
# DATABASE_URL=postgresql://postgres:safe-placeholder-password@localhost:5432/revio

# Option B: Individual Connection Parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revio
DB_USER=postgres
DB_PASSWORD=safe-placeholder-password
DB_SSL=false