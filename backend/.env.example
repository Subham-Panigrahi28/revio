PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Persistence Mode Configuration: 'development' or 'postgres'
PERSISTENCE_MODE=development

# PostgreSQL Connection Configuration (used when PERSISTENCE_MODE=postgres)
DATABASE_URL=postgresql://postgres:safe-placeholder-password@localhost:5432/clientchase

# Individual PostgreSQL Connection Parameters (fallback if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revio
DB_USER=postgres
DB_PASSWORD=safe-placeholder-password